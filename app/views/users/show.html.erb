<% content_for :scripts do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "users" %>
<% end %>

<div class="w-full bg-ncs-tweed bg-ncs-gray-700 rounded text-white h-100%">
  <div class="flex flex-col tab:flex-row gap-4">
    <div class="flex flex-col bg-ncs-grid basis-2/5">
      <div
        class="flex items-center flex-wrap bg-ncs-gray-500 px-2 py-1"
      >
        <h1 class="text-2xl mr-2 line-clamp-1 break-all" title="<%= @user.display_name %>">
          <%= @user.display_name %>
          <% if @user.role? %>
            <img class="inline w-6" src="<%= asset_path("medals/#{@user.role}.png") %>" alt="<%= @user.role.titleize %>" title="<%= @user.role.titleize %>" style="image-rendering: pixelated;">
          <% end %>
        </h1>
        <span class="text-2xl text-gray-500">@<%= @user.name %></span>
      </div>
      <div class="relative h-full">
        <%= render partial: "skins/skin_3d", locals: { data: @user.featured_skin_data, ears: @user.featured_skin_has_ears? } %>
        <div class="absolute top-0 bottom-0 left-0 w-12 tab:hidden"></div>
        <div class="absolute top-0 bottom-0 right-0 w-12 tab:hidden"></div>
      </div>
      <script>
        window.addEventListener("load", () => {
          skinViewer.nameTag = "<%= @user.name %>";
        })
      </script>
    </div>
    <div class="flex flex-col gap-2 p-4 grow">
      <div class="bg-ncs-gray-500 rounded p-4 pr-2 w-full relative">
        <h2 class="text-xl text-gray-500">Biography</h2>
        <div class="prose prose-invert h-[200px] overflow-auto pb-2 pr-2">
          <% if @user.biography.present? %>
            <%= markdown @user.biography %>
          <% else %>
            <p>A Miner in Need of Cooler Shoes...</p>
          <% end %>
          <div class="h-8 absolute bottom-4 left-0 right-4 bg-gradient-to-b from-transparent to-ncs-gray-500"></div>
        </div>
      </div>
      <div class="bg-ncs-gray-500 rounded p-4 w-full">
        <h2 class="text-xl text-gray-500 mb-2">Sharing URL</h2>
        <div class="flex gap-2">
          <p id="url_short" class="grow p-2 border bg-ncs-dark-700 border-ncs-dark-300 rounded"><%= @user.to_short_url %></p>
          <div class="relative">
            <button type="button" onclick="copyText('url_short')">
              <%= heroicon "document-duplicate", class: "inline" %>
            </button>
            <span class="copy-text hidden absolute -top-4 bg-ncs-dark-700 rounded-sm p-0.5 text-ncs-dark-100 text-sm select-none">
              <%= t "actions.copied" %>
            </span>
          </div>
        </div>
      </div>
      <div class="bg-ncs-gray-500 rounded p-4 w-full">
        <h2 class="text-xl text-gray-500">Stats</h2>
        <table class="text-left">
          <tr>
            <th class="pr-4">Joined:</th>
            <td><%= simple_date @user.created_at %></td>
          </tr>
          <tr>
            <th class="pr-4">Public Skins:</th>
            <td><%= simple_number @user.skins.is_public.count %></td>
          </tr>
          <tr class="bg-rainbow-animated text-white/60">
            <th class="pr-4">Pixels:</th>
            <td><%= simple_number @user.pixels! %></td>
          </tr>
        </table>
        <% if current_user == @user || current_user&.moderator? %>
          <hr class="border-gray-600 border-solid my-2">
          <table class="text-left">
            <tr>
              <th class="pr-4">Support Code:</th>
              <td class="spoiler"><%= @user.support_code.scan(/.{1,3}/).join("-") %></td>
            </tr>
          </table>
        <% end %>
      </div>
      <% if @user.badges.any? %>
        <div class="relative flex flex-wrap gap-2 bg-ncs-gray-500 rounded px-4 py-2 w-full">
          <% @user.user_badges.each do |user_badge| %>
            <% badge = user_badge.badge %>
            <div class="ncs-selectable cursor-pointer" tabindex="0">
              <img width="32" height="32" title="<%= badge.name %>" src="<%= badge.url %>" alt="<%= badge.name %>">
              <div class="cursor-auto overlay z-50 absolute flex flex-wrap gap-2 bg-ncs-gray-300 rounded px-4 py-2 mt-1 left-2 right-2 shadow border border-gray-600">
                <h2 class="font-bold"><%= badge.name %></h2>
                <p class="text-gray-400">Granted on <%= simple_date user_badge.created_at %></p>
                <p class="text-gray-200"><%= badge.description %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <div>
        <% if @user.can_user_edit?(current_user) %>
          <%= render partial: "actions_owner", locals: { user: @user } %>
        <% else %>
          <%= render partial: "actions_visitor", locals: { user: @user } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<script>
  // https://stackoverflow.com/questions/36639681/how-to-copy-text-from-a-div-to-clipboard
  function copyText(id, createText = false) {
    let element;
    if (createText) {
      element = document.createElement('span');
      element.innerText = id;
      document.body.append(element);
    } else {
      element = document.getElementById(id);
    }
    var range = document.createRange();
    range.selectNode(element);
    window.getSelection().removeAllRanges(); // clear current selection
    window.getSelection().addRange(range); // to select text
    document.execCommand("copy");
    window.getSelection().removeAllRanges();// to deselect

    const copied = element.parentElement.querySelector(".copy-text");
    copied.classList.remove("hidden", "hidden-fade");

    if (createText) { element.remove(); }

    setTimeout(() => {
      copied.classList.add("hidden-fade");
    }, 200);
  }
</script>