<% content_for :scripts do %>
  <%= stylesheet_link_tag "tagify", "data-turbo-track": "reload" %>
  <script type="module">
    import "ncrs-editor";
    import "src/editor";
  </script>
<% end %>

<% content_for :message do %>
  <% if @message %>
    <div id="message" class="p-2 bg-gradient-to-b from-[#313436] to-[#24272A] border-b border-[#3D4042] text-white">
      <%= markdown @message %>
    </div>
    <style>
      #message a {
        text-decoration: underline;
      }
    </style>
  <% end %>
<% end %>

<ncrs-ui id="ncrs-ui" class="relative" gallery="<%= skins_gallery_path %>">
  <div slot="export-form" class="text-white flex items-center justify-center pointer-events-none my-auto p-4">
    <div class="bg-[#222327] pointer-events-auto p-4 rounded">
      <% if current_user.present? %>
        <%= render partial: "new_form" %>
      <% else %>
        <%= render partial: "sign_in_form" %>
      <% end %>
    </div>
  </div>
  <div slot="footer">
    <div id="warning" class="hidden absolute top-0 bottom-0 left-0 right-0 z-[100] flex-col items-center bg-ncs-gray-700 text-white">
    </div>
  </div>
</ncrs-ui>

<div id="wiki" class="flex items-center text-sm gap-1">
  <button id="roll-tip" title="Get new tip"><%= heroicon "arrow-path", size: 18, variant: :mini %></button>
  <%= heroicon "information-circle", size: 16, variant: :mini, class: "min-w-4 min-h-4" %>
  <p id="tip">
    <noscript>
      Need help with the editor? Try the
      <a href="https://wiki.needcoolershoes.com" target="_blank" class="underline">wiki</a>!
    </noscript>
  </p>
</div>

<section id="about" class="mt-1 mb-2">
  <details>
    <summary class="cursor-pointer select-none"><h1 class="inline text-sm font-bold">Minecraft Skin Editor</h1></summary>
    <div class="space-y-2">
      <p>
        NeedCoolerShoes is a powerful but easy to use Minecraft skin editor featuring a layer first design.
        Simply search for parts you need for your skin, or create your own and share for all to use! With support for Slim and Classic model skins, ability to add reference images and pick colors from them, and a blend palette system, our skin editor has many different features you might not find in any other
        web-based editor.
      </p>
      <p>
        Browse Minecraft Skins in our community <a href="/gallery/skins" class="underline">Skin Gallery</a>
        or create your own with our easy to use Minecraft Skin Editor!
      </p>
      <p>
        Alternatively, browse Minecraft Banners and Capes in our community <a href="/gallery/banners" class="underline">Banner Gallery</a>
        or create your own with our <a href="/banner" class="underline">Banner Maker</a>.
      </p>
    </div>
  </details>
</section>

<style>
  ncrs-ui {
    max-width: 100%;
    width: 1000px;
    height: 670px;
    background-color: #222327;
    line-height: normal;
    overflow: auto;
    border-bottom-right-radius: 0.5rem;
    border-bottom-left-radius: 0.5rem; 
  }

  ncrs-ui.fullscreen {
    position: fixed;
    top:0;
    left:0;
    overflow-y: hidden;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    z-index: 100;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }

  ncrs-ui div[slot="export-form"] {
    display: none;
  }

  ncrs-ui:defined div[slot="export-form"] {
    display: initial;
  }

  ncrs-ui::part(export-form) {
    z-index: 100;
  }
</style>
