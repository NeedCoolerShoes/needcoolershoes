<!-- NOTHING TO TRANSLATE -->

<%= render partial: "shared/welcome" if params[:welcome].present? %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "skins" %>
<% end %>

<% content_for :filters do %>
<% end %>

<% content_for :filters do %>
  <% if can_use_gallery_filters? %>
    <%= render partial: "skins/index/skin_filters", locals: {params: @gallery_params, active_tags: @active_tags, tags: @tags} %>
  <% else %>
    <div class="bg-ncs-dark-700 p-2 pb-4 rounded-b text-ncs-dark-100">
      <p class="mb-2">
        Unfortunately, due to an increase in bot traffic, advanced search features have been temporarily disabled for users that are not signed in.
      </p>
      <p>Please <%= link_to "sign in", new_user_session_path, class: "underline" %> for advanced search.</p>
    </div>
  <% end %>
<% end %>

<% content_for :before_gallery do %>
  <div class="md:hidden w-full pt-2">
    <%= render partial: "shared/search", locals: { classes: "w-full", btn_classes: "btn-ncs shrink w-auto" } %>
  </div>
<% end %>

<% if @jam.present? %>
  <div class="mt-2">
    <%= render partial: "skins/index/jam_info", locals: { jam: @jam } %>
  </div>
<% end %>

<%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } %>
<% if @skins.any? %>
  <h1 class="text-ncs-dark-200 text-sm mb-2 -mt-2">
    Showing skins
    <span class="font-bold"><%= @pagy.from %></span>
    to <span class="font-bold"><%= @pagy.to %></span>
    of <span class="font-bold"><%= @pagy.count%></span>
  </h1>
<% end %>

<div class="grow">
  <% if !@skins.any? %>
    <div class="flex flex-col gap-2 items-center">
      <h1 class="text-4xl font-bold text-white">NO SKINS?</h1>
      <img src="<%= asset_path "megamewnd.png" %>" width="350" height="465.45" alt="Mascot">
      <p class="text-ncs-dark-200">Current search / filters yield no results.</p>
    </div>
  <% end %>
  <div class="grid grid-cols-1 mob:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    <%= render Gallery::SkinCardComponent.with_collection(@skins, params: @gallery_params, show_visibility: current_user) %>
  </div>
</div>
<%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } %>