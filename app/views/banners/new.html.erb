<% content_for :styles do %>
  <%= stylesheet_link_tag "tagify", "data-turbo-track": "reload" %>
  <style>
    ncrs-banner-ui:not(:defined) {
      display: none;
    }
  </style>
<% end %>
<% content_for :scripts do %>
  <meta name="turbo-visit-control" content="reload">
  <script type="module">
    import "ncrs-banner";
    import "src/banner/glue";
    import "src/banner/old_editor_import"
  </script>
<% end %>
<% content_for :message do %>
  <div class="p-2 bg-gradient-to-b from-[#313436] to-[#24272A] border-b border-[#3D4042] text-white mb-2">
    The banner editor has been updated for 1.21! If you have any feedback, please
    <%= link_to "Contact Us", contact_path, class: "underline" %>.
  </div>
<% end %>
<div id="app">
  <ncrs-banner-ui id="banner-ui">
    <div slot="export-form" class="m-2 mt-12 p-4 rounded bg-ncs-gray-900 max-w-lg w-full">
      <% if current_user.present? %>
        <h2 class="text-xl text-white">Upload Banner</h2>
        <%= render partial: "new_form", locals: {banner: @banner} %>
      <% else %>
        <%= render partial: "sign_in_form" %>
      <% end %>
    </div>
  </ncrs-banner-ui>
</div>
<p class="text-xs">Inspired from the original editor by <a class="underline" href="https://algoinde.ru/bngn">Algoinde</a></p>