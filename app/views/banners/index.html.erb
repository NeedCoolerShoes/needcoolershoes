<% content_for :filters do %>
  <% if can_use_gallery_filters? %>
    <%= render partial: "banners/index/banner_filters", locals: {params: @gallery_params, banners: @banners_all, active_tags: @active_tags, tags: @tags} %>
  <% else %>
    <div class="bg-ncs-dark-700 p-2 pb-4 rounded-b text-ncs-dark-100">
      <p class="mb-2">
        Unfortunately, due to an increase in bot traffic, advanced search features have been temporarily disabled for users that are not signed in.
      </p>
      <p>Please <%= link_to "sign in", new_user_session_path, class: "underline" %> for advanced search.</p>
    </div>
  <% end %>
<% end %>

<% content_for :before_gallery do %>
  <div class="md:hidden w-full pt-2">
    <%= render partial: "shared/search", locals: { classes: "w-full", btn_classes: "btn-ncs shrink w-auto" } %>
  </div>
<% end %>

<% content_for :styles do %>
  <%= stylesheet_link_tag "banners" %>
<% end %>
<% content_for :scripts do %>
  <script type="module">import "ncrs-banner";</script>
<% end %>

<%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } %>
<div class="flex flex-col mob:flex-row-reverse justify-between mb-2 -mt-2">
  <h1 class="text-ncs-dark-200 font-bold">Minecraft Banners</h1>
  <% if @banners.any? %>
    <h1 class="text-ncs-dark-200 text-sm">
      Showing banners
      <span class="font-bold"><%= @pagy.from %></span>
      to <span class="font-bold"><%= @pagy.to %></span>
      of <span class="font-bold"><%= @pagy.count%></span>
    </h1>
  <% end %>
</div>

<div class="grow">
  <% if !@banners.any? %>
    <div class="flex flex-col gap-2 items-center">
      <h1 class="text-4xl font-bold text-white">NO BANNERS?</h1>
      <img src="<%= asset_path "megamewnd.png" %>" width="350" height="465.45" alt="Mascot">
      <p class="text-ncs-dark-200">Current search / filters yield no results.</p>
    </div>
  <% end %>
  <div class="grid grid-cols-1 mob:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    <%= render Gallery::BannerCardComponent.with_collection(@banners, params: @gallery_params) %>
  </div>
</div>
<%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } %>

<% if @pagy.page == 1 %>
<details class="text-ncs-dark-100">
  <summary class="font-bold cursor-pointer select-none">Minecraft Banner Gallery</summary>
  <div class="flex flex-col gap-2">
    <p>
      Explore the best Minecraft Banners designed by our community. Find the perfect banner for any situation with our many advanced filters,
      or create your own using our <a href="<%= banner_editor_path %>" class="underline">banner editor</a>.
    </p>
    <p>
      You can search for banners, apply tags, and filter based on survival compatibility or whether it works as a shield.
      Once you have found a banner you like, you can follow the instructions to craft it in the loom, or use the command generator
      to make a command for creative.
    </p>
    <p>
      NeedCoolerShoes is the best way to browse for high quality Minecraft Banners, with creative new designs uploaded every day.
    </p>
  </div>
</details>
<% end %>