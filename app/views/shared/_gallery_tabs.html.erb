<%
  selected ||= :skins
  tab_params = params.slice(:user, :favourited_by, :tag, :order, :date_offset, :debug, :session).permit!
  tabs = [
    [:skins, "Skins", skins_gallery_path(tab_params)],
    [:banners, "Banners", banners_gallery_path(tab_params)],
  ]
%>

<ul class="flex items-end gap-1 text-lg mt-2 ncs-min:mt-4 font-bold">
  <% tabs.each do |tab| %>
    <%
      classes = (selected == tab[0] ? "bg-ncs-dark-700 text-ncs-blue sm:py-1" : "bg-ncs-dark-600 text-ncs-dark-200 sm:py-0.5" )
    %>
    <li class="rounded-t-lg <%= classes %>"><%= link_to tab[1], tab[2], class: "px-4 sm:px-6" %></li>
  <% end %>
</ul>