<% if notice.present? %>
  <div class="flex justify-center bg-yellow-400 p-2 relative z-50">
    <div class="max-w-ncs-content w-full formatting-basic">
      <%= markdown notice %>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="flex justify-center bg-red-500 p-2 relative z-50">
    <div class="max-w-ncs-content w-full formatting-basic">
      <%= markdown alert %>
    </div>
  </div>
<% end %>