<!-- TRANSLATED -->
<div class="bg-ncs-dark-700 p-4 rounded shadow max-w-none">
  <h1 class="text-3xl font-bold text-ncs-dark-100"><%= t "modlog.title" %></h1>

  <div id="warning" class="border border-ncs-red-100 outline outline-ncs-dark-600 bg-ncs-dark-600 text-ncs-dark-100 rounded p-2 font-bold mt-2"><%= t "modlog.warning" %></div>

  <div class="w-full mt-2">
    <%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } if @pagy.pages > 1 %>
    <div class="space-y-2">
      <%= render partial: "modlog", collection: @modlogs, as: :modlog %>
    </div>
    <%= render partial: "shared/pagy_nav", locals: { pagy: @pagy } if @pagy.pages > 1 %>
  </div>
</div>