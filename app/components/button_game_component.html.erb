<%= form_with url: button_path do %>
  <button href="/button" class="flex gap-2 group text-white" data-turbo="false">
    <img width="32" src="<%= asset_path "button/button_up.png" %>" id="button_game_up" class="group-hover:hidden group-active:hidden">
    <img width="32" src="<%= asset_path "button/button_mid.png" %>" id="button_game_mid" class="hidden group-hover:block group-active:hidden">
    <img width="32" src="<%= asset_path "button/button_down.png" %>" id="button_game_down" class="hidden group-active:block">
    <img width="32" src="<%= asset_path "button/button_dead.png" %>" id="button_game_dead" class="hidden">
    <div>
      <p class="text-xs uppercase">Will you press the button?</p>
      <p id="button_game_timer">xx:xx</p>
    </div>
  </button>
<% end %>

<script type="module">
  import { io } from "socket.io-client";

  let countdown = 9999;

  function updateTimer() {
    let minutes = Math.floor(countdown / 60).toString().padStart(2, "0");
    let seconds = Math.floor(countdown % 60).toString().padStart(2, "0");

    timer.innerText = minutes + ":" + seconds;
  }

  const socket = io("http://localhost:4000");
  socket.on("update_countdown", data => {
    countdown = data.timeRemaining;
    updateTimer()
  });

  const timer = document.getElementById("button_game_timer")


  setInterval(() => {
    if (countdown > 0) {
      countdown--;

      updateTimer();
    }
  }, 1000)

</script>