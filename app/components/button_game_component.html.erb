<%= form_with url: button_path do %>
  <button <%= has_pressed ? "disabled" : nil %> href="/button" class="flex gap-2 group text-white" data-turbo="false" id="button_game_button">
    <img width="32" src="<%= asset_path "button/button_up.png" %>" id="button_game_up" class="group-hover:hidden group-active:hidden">
    <img width="32" src="<%= asset_path "button/button_mid.png" %>" id="button_game_mid" class="hidden group-hover:block group-active:hidden">
    <img width="32" src="<%= asset_path "button/button_down.png" %>" id="button_game_down" class="hidden group-active:block">
    <img width="32" src="<%= asset_path "button/button_dead.png" %>" id="button_game_dead" class="hidden">
    <div>
      <% if has_pressed %>
        <p class="text-xs uppercase">You pressed the button.</p>
      <% else %>
      <p class="text-xs uppercase">Will you press the button?</p>
      <% end %>
      <p id="button_game_timer">xx:xx</p>
    </div>
  </button>
<% end %>

<script type="module">
  import { io } from "socket.io-client";

  let countdown = 9999;
  let alive = true;
  const hasPressed = <%= has_pressed ? "true" : "false" %>;

  const timer = document.getElementById("button_game_timer");
  const button = document.getElementById("button_game_button");
  const button_up = document.getElementById("button_game_up");
  const button_mid = document.getElementById("button_game_mid");
  const button_down = document.getElementById("button_game_down");
  const button_dead = document.getElementById("button_game_dead");

  if (hasPressed) {
    button_up.remove();
    button_mid.remove();
    button_down.classList.remove("hidden");
  }

  function updateTimer() {
    let minutes = Math.floor(countdown / 60).toString().padStart(2, "0");
    let seconds = Math.floor(countdown % 60).toString().padStart(2, "0");

    if (countdown > 0) {
      timer.innerText = minutes + ":" + seconds;
    } else {
      timer.innerText = "Time is up";
      if (alive) {
        button_game_button.disabled = true;
        button_dead.classList.remove("hidden");
        button_up.remove();
        button_mid.remove();
        button_down.remove();
      }
    }

  }

  const socket = io("https://thebutton.needcoolershoes.com");
  socket.on("update_countdown", data => {
    countdown = data.timeRemaining;
    updateTimer()
  });

  setInterval(() => {
    if (countdown > 0) {
      countdown--;

      updateTimer();
    }
  }, 1000)

</script>