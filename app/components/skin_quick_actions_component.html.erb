<div class="p-2" data-controller="hidden-toggle">
  <h3 class="text-white text-2xl font-bold text-center mb-2">Quick Actions</h3>

  <div data-hidden-toggle-target="select" data--select="main">
    <%= link_to "Moderate Skin", skin_moderate_path(@skin), class: "btn-ncs text-base py-0.5 px-2 mb-4" %>
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="unlist-skin" class="btn-ncs text-base py-0.5 px-2">
      Cleanup
    </button>
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="hide-skin" class="btn-ncs text-base py-0.5 px-2">
      TOS Violation
    </button>
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="categorize" class="btn-ncs text-base py-0.5 px-2">
      Update Part / Category
    </button>
  </div>

  <div data-hidden-toggle-target="select" data--select="unlist-skin" class="hidden">
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="main" class="btn-ncs text-base py-0.5 px-2 mb-4">
      Back
    </button>
    <%= button_to "Mark Duplicate", skin_quick_action_path(@skin, "duplicate"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <%= button_to "Mark Blank", skin_quick_action_path(@skin, "blank"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <%= button_to "Mark Low Effort", skin_quick_action_path(@skin, "low-effort"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <%= button_to "Mark Engagement Farming", skin_quick_action_path(@skin, "engagement-farming"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <% if @skin.classic? %>
      <%= button_to "Change model to Slim", skin_quick_action_path(@skin, "slim"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <% end %>
  </div>

  <div data-hidden-toggle-target="select" data--select="hide-skin" class="hidden">
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="main" class="btn-ncs text-base py-0.5 px-2 mb-4">
      Back
    </button>
    <%= button_to "Mark NSFW", skin_quick_action_path(@skin, "nsfw"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <%= button_to "Mark Bigotry / Hate Speech", skin_quick_action_path(@skin, "hate-speech"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
    <%= button_to "Mark Nazi / Hate Groups", skin_quick_action_path(@skin, "hate"), class: "btn-ncs text-base py-0.5 px-2", params: {redirect: @redirect} %>
  </div>

  <div data-hidden-toggle-target="select" data--select="categorize" class="hidden text-white">
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="main" class="btn-ncs text-base py-0.5 px-2 mb-4">
      Back
    </button>
    <%= form_with url: skin_quick_action_path(@skin, "categorize"), model: @skin do |form| %>
      <div class="flex flex-col gap-1 -mt-2">
        <%= form.label :skin_part_id %>
        <%= form.select :skin_part_id, SkinPart.pluck(:name, :id), {}, class: "capitalize p-1" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= form.label :skin_category_id %>
        <%= form.select :skin_category_id, SkinCategory.pluck(:name, :id), {}, class: "capitalize p-1" %>
      </div>

      <%= hidden_field_tag :redirect, @redirect %>

      <%= form.submit "Update Skin", class: "btn-ncs text-base py-0.5 px-2 mt-2" %>
    <% end %>
  </div>

  <div data-hidden-toggle-target="select" data--select="misc" class="hidden">
    <button data-action="click->hidden-toggle#select" data-hidden-toggle-select-param="main" class="btn-ncs text-base py-0.5 px-2 mb-4">
      Back
    </button>
  </div>
</div>