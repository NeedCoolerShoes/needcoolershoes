<% if @shield %>
  <div class="shield-overlay p-2 bg-cover">
    <ncrs-banner-preview style="--ncrs-banner-scale: 4" banner="<%= @banner.data %>" class="ncrs-shield-sprites pointer-events-none">
    </ncrs-banner-preview>
  </div>
<% else %>
  <ncrs-banner-preview style="--ncrs-banner-scale: 4" banner="<%= @banner.data %>" class="pointer-events-none"></ncrs-banner-preview>
<% end %>